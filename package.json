{
  "name": "program-capacity",
  "version": "0.1.0",
  "private": true,
  "description": "Program capacity and invoice reservation service for supply chain finance (NestJS, PostgreSQL, Kafka).",
  "type": "module",
  "scripts": {
    "cache:clean": "rm -rf node_modules dist coverage junit*.xml && echo 'Caches cleared. Run pnpm install to reinstall.'",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "(test -f .env || cp .env.example .env) && docker compose up -d --wait postgres redpanda && pnpm run build && portless run --name finverity --lan -- node --env-file-if-exists=.env dist/src/main.js",
    "migrate": "node dist/src/db/migrate.js",
    "token": "node dist/scripts/mint-token.js",
    "produce": "node dist/scripts/produce-treasury.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check --ignore-path .gitignore --ignore-path .prettierignore .",
    "format:fix": "prettier --write --ignore-path .gitignore --ignore-path .prettierignore .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=junit.xml",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "test:e2e:ci": "vitest run --config vitest.config.e2e.ts --reporter=default --reporter=junit --outputFile.junit=junit-e2e.xml",
    "docs:export": "node dist/scripts/export-openapi.js",
    "docs:check": "pnpm run build && pnpm run docs:export && git diff --exit-code docs/api/openapi.json",
    "docs:lint": "pnpm --package=@redocly/cli@2.71.2 dlx redocly lint docs/api/openapi.json",
    "ci:quality": "pnpm run format && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run docs:check && pnpm run test:tools && pnpm run audit:harness && pnpm run audit:invariants",
    "test:tools": "node --test tools/__tests__/*.test.mjs",
    "audit:harness": "node tools/harness-audit.mjs",
    "audit:invariants": "node tools/invariants-audit.mjs",
    "audit:submission": "node tools/invariants-audit.mjs --strict"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@10.22.0",
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "5.34.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^12.3.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redpanda": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "portless": "0.13.0",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}
