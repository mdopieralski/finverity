# Names and local defaults for every variable the service reads. Copy to .env for `pnpm run start:dev`.
# docker compose sets the same values itself, so `docker compose up` needs no .env.
PORT=3000
DATABASE_URL=postgres://capacity:capacity@localhost:55432/capacity
DB_POOL_SIZE=20
JWT_SECRET=dev-only-change-me-0123456789
JWT_ISSUER=
JWT_AUDIENCE=
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC=treasury.capacity.v1
KAFKA_GROUP_ID=program-capacity
API_DOCS=1
SEED_DEMO_DATA=true
FX_RATES=
