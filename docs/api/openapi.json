{
  "openapi": "3.0.0",
  "paths": {
    "/programs/{programId}/reservations": {
      "post": {
        "description": "Converts the invoice amount into the program currency **once, now** (rounded up), stores the amount,\nthe rate and its timestamp, and takes that much capacity. Never oversubscribes: the capacity check and\nthe write are one atomic statement.\n\n**Idempotent:** send a unique `Idempotency-Key` per invoice approval. A retry with the same key and the\nsame body returns the original response (`Idempotent-Replayed: true`), including a 422; the same key\nwith a different body is a 409.",
        "operationId": "createReservation",
        "parameters": [
          {
            "name": "programId",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^prg_[a-z0-9_]{1,64}$",
              "example": "prg_eur_acme"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Unique per reservation attempt, 1-255 printable ASCII characters. Scoped to the token subject.",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 255,
              "example": "approval-INV-1001"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReserveRequestDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserved (or the replay of an earlier 201).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`: The request is invalid.<br>`invalid_amount`: amountMinor must be a positive integer string in minor units.<br>`idempotency_key_required`: Idempotency-Key header is required (1-255 printable characters).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "examples": {
                  "invalid_request": {
                    "summary": "invalid_request",
                    "value": {
                      "error": {
                        "code": "invalid_request",
                        "message": "The request is invalid.",
                        "requestId": "b2c4…"
                      }
                    }
                  },
                  "invalid_amount": {
                    "summary": "invalid_amount",
                    "value": {
                      "error": {
                        "code": "invalid_amount",
                        "message": "amountMinor must be a positive integer string in minor units.",
                        "requestId": "b2c4…"
                      }
                    }
                  },
                  "idempotency_key_required": {
                    "summary": "idempotency_key_required",
                    "value": {
                      "error": {
                        "code": "idempotency_key_required",
                        "message": "Idempotency-Key header is required (1-255 printable characters).",
                        "requestId": "b2c4…"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "unauthenticated",
                    "message": "Authentication required.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`program_not_found`: Program not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "program_not_found",
                    "message": "Program not found.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "409": {
            "description": "`idempotency_key_reused`: Idempotency-Key was already used with a different request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "idempotency_key_reused",
                    "message": "Idempotency-Key was already used with a different request.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "422": {
            "description": "`insufficient_capacity`: Insufficient capacity on this program.<br>`fx_rate_unavailable`: No exchange rate is available for this currency pair.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "examples": {
                  "insufficient_capacity": {
                    "summary": "insufficient_capacity",
                    "value": {
                      "error": {
                        "code": "insufficient_capacity",
                        "message": "Insufficient capacity on this program.",
                        "requestId": "b2c4…"
                      }
                    }
                  },
                  "fx_rate_unavailable": {
                    "summary": "fx_rate_unavailable",
                    "value": {
                      "error": {
                        "code": "fx_rate_unavailable",
                        "message": "No exchange rate is available for this currency pair.",
                        "requestId": "b2c4…"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "`internal`: Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "Internal error.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable`: Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "service_unavailable",
                    "message": "Service temporarily unavailable.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          }
        },
        "summary": "Reserve capacity for an invoice approved for early payment",
        "tags": [
          "Programs"
        ]
      },
      "get": {
        "description": "Keyset pagination: pass `nextCursor` back as `cursor`. Stable while new reservations arrive.",
        "operationId": "listReservations",
        "parameters": [
          {
            "name": "programId",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^prg_[a-z0-9_]{1,64}$",
              "example": "prg_eur_acme"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Opaque, from `nextCursor`."
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "ACTIVE",
                "RELEASED"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationPageDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`: The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "The request is invalid.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "unauthenticated",
                    "message": "Authentication required.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`program_not_found`: Program not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "program_not_found",
                    "message": "Program not found.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "500": {
            "description": "`internal`: Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "Internal error.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable`: Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "service_unavailable",
                    "message": "Service temporarily unavailable.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          }
        },
        "summary": "List a program’s reservations, newest first",
        "tags": [
          "Programs"
        ]
      }
    },
    "/programs/{programId}/availability": {
      "get": {
        "description": "Without `asOf`: the current figures. With `asOf`: recomputed from the append-only ledger up to that instant, as an auditor would.",
        "operationId": "getAvailability",
        "parameters": [
          {
            "name": "programId",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^prg_[a-z0-9_]{1,64}$",
              "example": "prg_eur_acme"
            }
          },
          {
            "name": "asOf",
            "required": false,
            "in": "query",
            "description": "ISO-8601 instant with an offset, not in the future.",
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-10-28T10:00:00Z"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
