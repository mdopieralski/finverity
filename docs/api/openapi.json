        "summary": "Current availability, or availability at a past instant",
        "tags": [
          "Programs"
        ]
      }
    },
    "/reservations/{reservationId}/release": {
      "post": {
        "description": "Gives back exactly the amount the reservation took, in the program currency: never reconverted at a new rate. Idempotent by state: releasing an already released reservation returns it unchanged.",
        "operationId": "releaseReservation",
        "parameters": [
          {
            "name": "reservationId",
            "required": true,
            "in": "path",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Released (now, or earlier).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReservationDto"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_request`: The request is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "invalid_request",
                    "message": "The request is invalid.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "unauthenticated",
                    "message": "Authentication required.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "404": {
            "description": "`reservation_not_found`: Reservation not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "reservation_not_found",
                    "message": "Reservation not found.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "500": {
            "description": "`internal`: Internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "internal",
                    "message": "Internal error.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "503": {
            "description": "`service_unavailable`: Service temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "service_unavailable",
                    "message": "Service temporarily unavailable.",
                    "requestId": "b2c4…"
                  }
                }
              }
            }
          }
        },
        "summary": "Release a reservation on repayment",
        "tags": [
