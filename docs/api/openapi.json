        ]
      }
    }
  },
  "info": {
    "title": "Program capacity",
    "description": "Tracks a supply chain finance program's credit capacity in real time: invoices approved for early payment\n**reserve** capacity, repayment **releases** it, and the funder's treasury system adjusts and reconciles the\nlimit over Kafka.\n\n### Authentication\nEvery operation needs `Authorization: Bearer <JWT>` (HS256, signed with the service's `JWT_SECRET`).\nLocally: `pnpm run token`. Use **Authorize** above; _Try it out_ then sends the token.\n\n### Money\nEvery amount is a **string of integer minor units** in the currency next to it: EUR 12,500.00 is `\"1250000\"`,\n¥500 is `\"500\"` (JPY has no minor unit). Fractions, numbers and exponents are rejected with 400.\nResponses carry `exponent` so a client can format them.\n\n### Currency conversion\nAn invoice in another currency is converted into the program currency **once, at reservation time**, rounded\nup, and the rate and its timestamp are stored on the reservation. A release gives back exactly the stored\namount; it is never reconverted.\n\n### Idempotency\n`POST /programs/{programId}/reservations` requires an `Idempotency-Key`. The same key with the same body\nreturns the original response (header `Idempotent-Replayed: true`); with a different body it is a 409.\nReleases are idempotent by state.\n\n### Errors\n`{ \"error\": { \"code\", \"message\", \"requestId\" } }`. Messages are fixed strings per code; internal detail is\nonly logged. Every response carries `X-Request-Id`.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Programs",
      "description": "Reserve capacity, read availability, list reservations."
    },
    {
      "name": "Reservations",
      "description": "Release a reservation on repayment."
    }
  ],
  "servers": [
    {
      "url": "/",
      "description": "This server"
    }
  ],
  "components": {
    "securitySchemes": {
      "jwt": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ReserveRequestDto": {
        "type": "object",
        "properties": {
          "invoiceRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,63}$",
            "example": "INV-1001",
            "description": "The supplier invoice approved for early payment (the funder's reference)."
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$",
            "example": "1250000",
            "description": "Invoice amount in integer minor units of `currency` (USD 12,500.00 = \"1250000\"; JPY has no minor unit)."
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "PLN",
              "CHF",
              "JPY"
            ],
            "example": "USD",
            "description": "Invoice currency. Converted once, now, into the program currency if they differ."
          }
        },
        "required": [
          "invoiceRef",
          "amountMinor",
          "currency"
        ]
      },
      "InvoiceAmountDto": {
        "type": "object",
        "properties": {
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$",
            "example": "1250000",
            "description": "Invoice amount as submitted, in minor units of `currency`."
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "PLN",
              "CHF",
              "JPY"
            ],
            "example": "USD",
            "description": "Invoice currency."
          }
        },
        "required": [
          "amountMinor",
          "currency"
        ]
      },
      "FxDto": {
        "type": "object",
        "properties": {
          "rate": {
            "type": "string",
            "example": "0.909091",
            "description": "Program-currency units per one invoice-currency unit, as used. \"1\" when the currencies match."
          },
          "rateAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the rate was fixed."
          },
          "source": {
            "type": "string",
            "example": "fixed-table",
            "description": "Where the rate came from."
          }
        },
        "required": [
          "rate",
          "rateAt",
          "source"
        ]
      },
      "ReservationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "6f1c2a9e-3b0d-4c55-9a51-2f1f6a7c9d10"
          },
          "programId": {
            "type": "string",
            "example": "prg_eur_acme"
          },
          "invoiceRef": {
            "type": "string",
            "example": "INV-1001"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "RELEASED"
            ],
            "example": "ACTIVE"
          },
          "amountMinor": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,17}$",
            "example": "1136364",
            "description": "Capacity taken, in minor units of the PROGRAM currency, rounded up. Release gives back exactly this."
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "PLN",
              "CHF",
              "JPY"
            ],
            "example": "EUR",
            "description": "Program currency."
          },
          "exponent": {
            "type": "integer",
            "example": 2,
            "description": "Minor-unit exponent of `currency` (2 for EUR, 0 for JPY)."
          },
          "invoice": {
            "$ref": "#/components/schemas/InvoiceAmountDto"
          },
          "fx": {
            "$ref": "#/components/schemas/FxDto"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "releasedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": null
          }
        },
        "required": [
          "id",
          "programId",
          "invoiceRef",
          "status",
          "amountMinor",
          "currency",
          "exponent",
          "invoice",
          "fx",
          "createdAt",
          "releasedAt"
        ]
      },
      "ErrorDetailDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "invalid_request",
              "invalid_amount",
              "idempotency_key_required",
              "program_not_found",
              "reservation_not_found",
              "route_not_found",
              "idempotency_key_reused",
              "insufficient_capacity",
              "fx_rate_unavailable",
              "service_unavailable",
              "internal"
            ],
            "example": "insufficient_capacity"
          },
          "message": {
            "type": "string",
            "example": "Insufficient capacity on this program.",
            "description": "A fixed string per code."
          },
          "requestId": {
            "type": "string",
            "example": "0b6d7f0e-4f2a-4a8e-9a3e-3c2a1d9b8e71",
            "description": "Echoed in X-Request-Id and the logs."
          },
          "fields": {
            "example": [
              "amountMinor"
            ],
            "description": "Offending field names (never their values).",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorBodyDto": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetailDto"
          }
        },
        "required": [
          "error"
        ]
      },
      "AvailabilityDto": {
        "type": "object",
        "properties": {
          "programId": {
            "type": "string",
            "example": "prg_eur_acme"
          },
          "currency": {
            "type": "string",
            "enum": [
              "EUR",
              "USD",
              "GBP",
              "PLN",
              "CHF",
              "JPY"
            ],
            "example": "EUR",
            "description": "Program currency: every amount below is in it."
          },
          "exponent": {
            "type": "integer",
            "example": 2
          },
          "creditLimitMinor": {
            "type": "string",
            "pattern": "^-?[0-9]{1,19}$",
            "example": "1000000000",
            "description": "Credit limit set by treasury."
          },
          "treasuryUtilisedMinor": {
            "type": "string",
            "pattern": "^-?[0-9]{1,19}$",
            "example": "0",
            "description": "Utilisation treasury reports from outside this service."
          },
          "reservedMinor": {
            "type": "string",
            "pattern": "^-?[0-9]{1,19}$",
            "example": "1136364",
            "description": "Sum of ACTIVE reservations made through this service."
          },
          "availableMinor": {
            "type": "string",
            "pattern": "^-?[0-9]{1,19}$",
            "example": "998863636",
            "description": "creditLimit − treasuryUtilised − reserved. Negative if treasury cut the limit below utilisation."
          },
          "treasurySequence": {
            "type": "string",
            "example": "0",
            "description": "Last treasury sequence applied."
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The instant this was computed for: null = now (current figures); set = folded from the ledger."
          }
        },
        "required": [
          "programId",
          "currency",
          "exponent",
          "creditLimitMinor",
          "treasuryUtilisedMinor",
          "reservedMinor",
          "availableMinor",
          "treasurySequence",
          "asOf"
        ]
      },
      "ReservationPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationDto"
            }
          },
          "nextCursor": {
            "type": "string",
            "nullable": true,
            "description": "Pass as `cursor` to get the next page; null on the last page."
          }
        },
        "required": [
          "items"
        ]
      }
    }
  },
  "security": [
    {
      "jwt": []
    }
  ]
}
