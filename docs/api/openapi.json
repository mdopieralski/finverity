                    "requestId": "b2c4…"
                  }
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`: Authentication required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                },
                "example": {
                  "error": {
                    "code": "unauthenticated",
